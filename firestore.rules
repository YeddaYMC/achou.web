rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================

    // Retorna true se o usuario está logado
    function logado() {
      return request.auth != null;
    }

    // Retorna true se o usuario logado tem a claim "admin" definida como true
    // (essa claim é definida via Admin SDK ou Cloud Function)
    // Ou se o documento /usuarios/{uid} contém um campo `papel` com valor de administrador
    function administrador() {
      return logado() && (
        // claims custom via Admin SDK (aceita 'admin', 'moderador' ou 'super_admin')
        request.auth.token.admin == true
        || request.auth.token.moderador == true
        || request.auth.token.super_admin == true
        // OU papel salvo no documento de usuário: 'admin', 'moderador' ou 'super_admin'
        || (
          // Compatibilidade com campos legados: papel / permissao / PERMISSAO
          (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel in ['admin', 'moderador', 'super_admin'])
          || (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.permissao in ['admin', 'moderador', 'super_admin'])
          || (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.PERMISSAO in ['admin', 'moderador', 'super_admin'])
        )
      );
    }

    // Retorna true se o usuario logado é super_admin (claim ou campo no doc)
    function superAdmin() {
      return logado() && (
        request.auth.token.super_admin == true
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'super_admin'
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.permissao == 'super_admin'
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.PERMISSAO == 'super_admin'
      );
    }

    // Modo de teste: sem bloqueio por plano, exigindo exatamente 1 foto por anuncio
    function validarConteudoAnuncioTeste() {
      let dados = request.resource.data;
      let quantidadeFotos = dados.get('fotos', []).size();
      return quantidadeFotos == 1;
    }

    // ============================================================
    // USUÁRIOS
    // Cada usuario so acessa e edita o proprio perfil.
    // O administrador NAO tem acesso de leitura a perfis.
    // ============================================================
    match /usuarios/{userId} {
       // Permitir leitura: próprio usuário ou administrador (para listagem/gestão)
       allow read: if logado() && (request.auth.uid == userId || administrador());

       // Somente o proprio usuario pode criar o proprio perfil
       // O nivel do plano deve ser um valor valido (1, 2, 3 ou 4)
       allow create: if logado()
                && request.auth.uid == userId
                && request.resource.data.nivelAnunciante in [1, 2, 3, 4];

       // Atualização: o próprio usuário pode atualizar seu perfil normalmente;
       // administradores podem alterar somente os campos de papel/permissão;
       // super_admin tem permissão total para atualizar qualquer campo do documento.
       allow update: if (
                   // Dono atualizando seu próprio perfil
                   logado()
                   && request.auth.uid == userId
                   && request.resource.data.nivelAnunciante in [1, 2, 3, 4]
                 ) || (
                   // Admins (admin/moderador) podem alterar somente os campos de papel/permissão
                   administrador()
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'PERMISSAO', 'permissao', 'papel'
                   ])
                 ) || (
                   // Super admin pode alterar qualquer campo do documento de usuário
                   superAdmin()
                 );

      // Somente o proprio usuario pode excluir a propria conta
      allow delete: if logado() && request.auth.uid == userId;
    }

    // ============================================================
    // ANÚNCIOS (colecao "anuncios")
    // Qualquer pessoa pode ver anúncios aprovados.
    // Usuários logados podem criar anúncios com status 'pendente'.
    // Moderadores/admin podem aprovar/reprovar anúncios.
    // ============================================================
    match /anuncios/{anuncioId} {
      // Qualquer pessoa pode ver os anúncios
      allow read: if true;

      // Usuários logados podem criar anúncios com status 'pendente'
      allow create: if logado()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.status == 'pendente'
                    && validarConteudoAnuncioTeste();

      // Dono pode editar seu anúncio (exceto campos de moderação)
      // Admin/moderador pode alterar status e campos de moderação
      allow update: if (
                      // Dono editando seu anúncio
                      logado()
                      && request.resource.data.usuarioId == request.auth.uid
                      && validarConteudoAnuncioTeste()
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'totalFavoritos', 'status', 'moderadoPor', 'moderadoEm', 'motivoReprovacao'
                      ])
                    ) || (
                      // Admin/moderador moderando anúncio
                      administrador()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'moderadoPor', 'moderadoEm', 'motivoReprovacao', 'atualizadoEm'
                      ])
                      && request.resource.data.status in ['aprovado', 'reprovado', 'arquivado']
                    );

      // Dono ou administrador pode excluir anúncio
      allow delete: if (logado() && resource.data.usuarioId == request.auth.uid)
            || administrador();
    }

    // ============================================================
    // FAVORITOS (subcoleção /usuarios/{userId}/favoritos/{itemId})
    // Cada usuario tem sua propria lista de favoritos como subcoleção.
    // Somente o dono pode ver sua propria lista.
    // Qualquer usuario logado pode adicionar ou remover da propria lista.
    // O total de favoritos fica no campo "totalFavoritos" do anuncio.
    // ============================================================
    match /usuarios/{userId}/favoritos/{itemId} {
      // Somente o proprio usuario pode ver sua lista de favoritos
      allow read, list: if logado() && request.auth.uid == userId;

      // Qualquer usuario logado pode adicionar um item aos proprios favoritos
      allow create: if logado() && request.auth.uid == userId;

      // Qualquer usuario logado pode remover um item dos proprios favoritos
      allow delete: if logado() && request.auth.uid == userId;
    }

    // ============================================================
    // MENSAGENS DE CONTATO (colecao "mensagensContato")
    // Usuario envia mensagem. Admin pode ler.
    // ============================================================
    match /mensagensContato/{mensagemId} {
      // Permite envio de mensagem de contato
      allow create: if true;

      // Somente admin pode ler mensagens recebidas
      allow read: if administrador();

      // Somente admin pode atualizar status interno
      allow update: if administrador();

      // Ninguem exclui mensagem pelo app
      allow delete: if false;
    }

    // ============================================================
    // DENÚNCIAS (colecao "denuncias")
    // Usuários logados podem criar denúncias.
    // Moderadores/admin podem resolver denúncias.
    // ============================================================
    match /denuncias/{denunciaId} {
      // Qualquer usuário logado pode ver denúncias (para moderação)
      allow read: if logado();

      // Usuários logados podem criar denúncias
      allow create: if logado()
                    && request.resource.data.denuncianteId == request.auth.uid
                    && request.resource.data.status == 'aberta';

      // Moderadores/admin podem resolver denúncias
      allow update: if administrador()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status', 'moderadoPor', 'moderadoEm', 'decisao', 'justificativa'
                    ])
                    && request.resource.data.status == 'resolvida'
                    && request.resource.data.decisao in ['aceita', 'nao_aceita'];

      // Ninguém pode excluir denúncias (auditoria)
      allow delete: if false;
    }

  }
}

