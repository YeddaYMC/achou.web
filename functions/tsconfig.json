{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "ES2020",
    "resolveJsonModule": true,
    "declaration": true,
    "ignoreDeprecations": "6.0"
  },
  "compileOnSave": true,
  "include": ["src"]
}
